---
import SectionLabel from './SectionLabel.astro';
import CompareSlider from './CompareSlider.astro';
import { residentialMedia } from '../data/media';

/**
 * Before & After.
 *
 * Arriba, par REAL de un pool deck (llegado 2026-09-24): mismo fondo, misma
 * valla y palmeras en las dos fotos. Sin nombre ni direccion del cliente.
 *
 * Debajo, "potencial" (pedido por el cliente 2026-10-13): fotos reales de
 * una casa tal como esta hoy y una visualizacion IA de los mismos espacios
 * con pavers. El despues va etiquetado como AI visualization y el texto lo
 * dice: no se presenta como obra ejecutada.
 */
const { before, after } = residentialMedia.beforeAfter;
const visualized = residentialMedia.visualizedBeforeAfter;
---

<section class="section surface-dark on-dark" id="before-after">
  <div class="shell ba__grid">
    <div class="ba__text">
      <SectionLabel label="Real transformations" />
      <h2 class="t-h1 ba__title">Before &amp; After</h2>
      <p class="ba__body">
        See how we turn ordinary spaces into exceptional outdoor living environments.
      </p>
      <a href="/projects" class="btn btn-primary">View Inspiration Gallery</a>
    </div>

    <CompareSlider
      before={before}
      after={after}
      description="Comparison slider between the before and after state of a completed project."
    />
  </div>

  {
    visualized.length > 0 && (
      <div class="shell ba__potential">
        <h3 class="t-h2 ba__potential-title">Picture your home with pavers</h3>
        <p class="ba__body ba__potential-body">
          A South Florida home as it is today, next to an AI visualization of the same spaces
          finished with pavers: cleaner lines, usable outdoor rooms and stronger curb appeal.
        </p>

        <ul class="ba__pairs">
          {visualized.map((pair) => (
            <li>
              <CompareSlider
                before={pair.before}
                after={pair.after}
                afterKind="ai"
                ratio="4 / 3"
                sizes="(min-width: 62rem) 45vw, 100vw"
                description={`${pair.caption}: real photo today compared with an AI visualization with pavers.`}
              />
              <p class="t-label ba__pair-caption">{pair.caption}</p>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .ba__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .ba__title {
    margin: 0 0 1.25rem;
  }

  .ba__body {
    margin: 0 0 2rem;
    max-width: 34ch;
    color: color-mix(in srgb, var(--color-warm-cream) 82%, transparent);
  }

  .ba__potential {
    margin-top: clamp(4rem, 8vw, 6.5rem);
  }

  .ba__potential-title {
    margin: 0 0 1rem;
  }

  .ba__potential-body {
    max-width: 56ch;
  }

  .ba__pairs {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ba__pair-caption {
    margin: 0.9rem 0 0;
  }

  @media (min-width: 48rem) {
    .ba__pairs {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 62rem) {
    .ba__grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
</style>
