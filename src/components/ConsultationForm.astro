---
import { segments } from '../data/segments';
import { services } from '../data/services';
import { site } from '../data/site';

/**
 * Formulario de consulta.
 *
 * El destino esta PENDIENTE (decision 3): no hay CRM en esta fase. Mientras
 * `site.formEndpoint` sea null el envio queda deshabilitado con un aviso
 * visible y se ofrece el correo como alternativa real, en lugar de fingir
 * un envio que se perderia. Cuando se decida el destino basta con poner la
 * URL en site.ts: es el unico punto a tocar.
 *
 * La validacion vive en scripts/form-validation.ts (compartida con el
 * formulario comercial).
 */
const enabled = site.formEndpoint !== null;
---

<form
  class="form"
  id="consultation-form"
  method="post"
  action={site.formEndpoint ?? undefined}
  novalidate
>
  {
    !enabled && (
      <p class="form__notice" role="status">
        <strong>Online submission is not connected yet.</strong> Send your project details to{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a> and we will get back to you.
      </p>
    )
  }

  <div
    class="form__errors"
    id="form-errors"
    role="alert"
    aria-live="assertive"
    hidden
  >
  </div>

  <div class="form__row">
    <div class="field">
      <label class="t-label field__label" for="name">Full name</label>
      <input class="field__input" type="text" id="name" name="name" required autocomplete="name" />
    </div>

    <div class="field">
      <label class="t-label field__label" for="email">Email</label>
      <input class="field__input" type="email" id="email" name="email" required autocomplete="email" />
    </div>
  </div>

  <div class="form__row">
    <div class="field">
      <label class="t-label field__label" for="phone">
        Phone <span class="field__optional">(optional)</span>
      </label>
      <input class="field__input" type="tel" id="phone" name="phone" autocomplete="tel" />
    </div>

    <div class="field">
      <label class="t-label field__label" for="project-type">Project type</label>
      <select class="field__input" id="project-type" name="projectType" required>
        <option value="">Select an option</option>
        {segments.map((segment) => <option value={segment.id}>{segment.label}</option>)}
      </select>
    </div>
  </div>

  <div class="field">
    <label class="t-label field__label" for="service">Service of interest</label>
    <select class="field__input" id="service" name="service" required>
      <option value="">Select a service</option>
      {services.map((service) => <option value={service.slug}>{service.name}</option>)}
    </select>
  </div>

  <div class="field">
    <label class="t-label field__label" for="message">Tell us about your space</label>
    <textarea class="field__input field__textarea" id="message" name="message" rows="5" required
    ></textarea>
  </div>

  <p class="form__status" data-form-status role="status" hidden></p>

  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="form__trap" aria-hidden="true" />

  <button type="submit" class="btn btn-solid form__submit" disabled={!enabled}>
    Request a Consultation
  </button>
</form>

<script>
  import { bindFormValidation } from '../scripts/form-validation';
  import { bindFormSubmit } from '../scripts/form-submit';

  const form = document.getElementById('consultation-form');
  const errorBox = document.getElementById('form-errors');

  if (form instanceof HTMLFormElement && errorBox) {
    bindFormValidation(form, errorBox);
    bindFormSubmit(form, 'Thank you. We received your request and will get back to you shortly.');
  }
</script>

<style>
  .form__status {
    margin: 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-warm-taupe);
    background-color: color-mix(in srgb, var(--color-sandstone) 30%, var(--color-warm-cream));
    font-size: 0.9375rem;
  }

  .form__status[data-kind='error'] {
    border-left-color: #9b2c2c;
    background-color: color-mix(in srgb, #9b2c2c 8%, var(--color-warm-cream));
  }

  /* Honeypot anti-spam: fuera de pantalla, no display:none (los bots lo detectan). */
  .form__trap {
    position: absolute;
    left: -9999px;
  }

  .form {
    display: grid;
    gap: 1.5rem;
    max-width: 44rem;
  }

  .form__row {
    display: grid;
    gap: 1.5rem;
  }

  .form__notice {
    margin: 0;
    padding: 1rem 1.25rem;
    background-color: color-mix(in srgb, var(--color-sandstone) 30%, var(--color-warm-cream));
    border-left: 3px solid var(--color-warm-taupe);
    font-size: 0.9375rem;
  }

  .form__notice a {
    border-bottom: 1px solid currentColor;
  }

  .form__errors {
    padding: 1rem 1.25rem;
    border-left: 3px solid #9b2c2c;
    background-color: color-mix(in srgb, #9b2c2c 8%, var(--color-warm-cream));
    font-size: 0.9375rem;
  }

  .form__errors p {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  .form__errors ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .form__errors a {
    border-bottom: 1px solid currentColor;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .field__label {
    color: var(--color-charcoal);
  }

  .field__optional {
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.7;
  }

  .field__input {
    min-height: 3rem;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-rich-black);
    background-color: #fff;
    border: 1px solid color-mix(in srgb, var(--color-charcoal) 35%, transparent);
    transition: border-color 200ms ease;
  }

  .field__input:hover {
    border-color: color-mix(in srgb, var(--color-charcoal) 60%, transparent);
  }

  .field__input[aria-invalid='true'] {
    border-color: #9b2c2c;
    border-width: 2px;
  }

  .field__textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .form__submit {
    justify-self: start;
  }

  @media (min-width: 40rem) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
