---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-header surface-dark on-dark">
  <div class="shell page-header__inner">
    <p class="t-label page-header__eyebrow">{eyebrow}</p>
    <h1 class="t-h1 page-header__title">{title}</h1>
    {lead && <p class="measure page-header__lead">{lead}</p>}
  </div>
</section>

<style>
  .page-header__inner {
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }

  .page-header__eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-sandstone);
  }

  .page-header__title {
    margin: 0;
    max-width: 18ch;
  }

  .page-header__lead {
    margin: 1.5rem 0 0;
    color: color-mix(in srgb, var(--color-warm-cream) 82%, transparent);
  }
</style>
