---
import SectionLabel from './SectionLabel.astro';
import MediaSlot from './MediaSlot.astro';
import AiImage from './AiImage.astro';
import PhotoImage from './PhotoImage.astro';
import { segments } from '../data/segments';
import { commercialMedia, residentialMedia } from '../data/media';
import { showPending } from '../data/flags';

/**
 * Galeria "Outdoor Living Inspiration" (pedido del cliente 2026-10-16:
 * StoneCraft aun construye su portfolio, asi que no se llama "Selected
 * work"). Dos categorias visibles a la vez, sin depender del segmento:
 * Residential Inspiration y Commercial Concepts. Las imagenes IA llevan su
 * etiqueta (AiImage); nada se presenta como obra comercial ejecutada.
 *
 * Comercial: visualizaciones IA con pie por TIPO de proyecto (acordado
 * 2026-09-13). Residencial: fotografia real de obra ejecutada (llegada
 * 2026-09-24), tambien con pie por TIPO de espacio unicamente. Ninguno de
 * los dos segmentos lleva nombre, ubicacion ni alcance: esos datos no se
 * entregaron y no se inventan. Si un segmento tiene menos fotos reales que
 * `count`, el resto queda como hueco marcado en vez de repetir imagenes.
 */
interface Props {
  showLink?: boolean;
  count?: number;
}

const { showLink = true, count = 6 } = Astro.props;
const commercialProjects = commercialMedia.projects.slice(0, count);
const residentialProjects = residentialMedia.projects.slice(0, count);
const residentialPlaceholders = Array.from(
  // En la version publica no hay huecos: la rejilla se queda con las fotos reales.
  { length: showPending ? Math.max(count - residentialProjects.length, 0) : 0 },
  (_, i) => residentialProjects.length + i + 1,
);
---

<section class="section" id="projects">
  <div class="shell">
    <SectionLabel
      label="Outdoor Living Inspiration"
      linkLabel={showLink ? 'View the gallery' : undefined}
      linkHref={showLink ? '/projects' : undefined}
    />

    {
      segments.map((segment) => (
        <div class="projects__category">
        <h2 class="t-h3 projects__heading">
          {segment.id === 'commercial' ? 'Commercial Concepts' : 'Residential Inspiration'}
        </h2>
        <ul class="projects__grid">
          {segment.id === 'commercial'
            ? commercialProjects.map((project) => (
                <li class="projects__item">
                  <AiImage
                    image={project}
                    ratio="3 / 2"
                    sizes="(min-width: 62rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                  />
                  <p class="t-label projects__caption">{project.caption}</p>
                </li>
              ))
            : (
              <>
                {residentialProjects.map((project) => (
                  <li class="projects__item">
                    <PhotoImage
                      image={project}
                      ratio="3 / 2"
                      sizes="(min-width: 62rem) 33vw, (min-width: 40rem) 50vw, 100vw"
                    />
                    <p class="t-label projects__caption">{project.caption}</p>
                  </li>
                ))}
                {residentialPlaceholders.map((n) => (
                  <li class="projects__item">
                    <MediaSlot
                      ratio="3 / 2"
                      label={`${segment.label} project ${n}: photograph, name, location and scope`}
                    />
                  </li>
                ))}
              </>
            )}
        </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .projects__category + .projects__category {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .projects__heading {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .projects__caption {
    margin: 1rem 0 0;
    color: var(--color-charcoal);
  }

  @media (min-width: 40rem) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 62rem) {
    .projects__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
