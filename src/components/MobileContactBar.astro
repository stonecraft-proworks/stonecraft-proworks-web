---
import { site } from '../data/site';

/**
 * Barra movil Call / Text / WhatsApp del boceto (confirmada, decision 13).
 *
 * Depende del telefono, que sigue PENDIENTE (decision 2). Sin numero no se
 * renderiza: un boton de llamada que no llama es peor que no tenerlo.
 * En cuanto `site.phone` tenga valor, la barra aparece sola.
 */
const { phone, whatsapp } = site;
const wa = whatsapp ?? phone;
---

{
  phone && (
    <div class="contact-bar">
      <a href={`tel:${phone}`} class="contact-bar__item">
        <span aria-hidden="true" class="contact-bar__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 006.5 6.5L17 13l4 1.5v3a2 2 0 01-2.2 2A17 17 0 013.5 5.2 2 2 0 015.5 3z" />
          </svg>
        </span>
        Call
      </a>

      <a href={`sms:${phone}`} class="contact-bar__item">
        <span aria-hidden="true" class="contact-bar__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 4h16v12H8l-4 4z" />
          </svg>
        </span>
        Text
      </a>

      {wa && (
        <a
          href={`https://wa.me/${wa.replace(/\D/g, '')}`}
          class="contact-bar__item"
          rel="noopener"
        >
          <span aria-hidden="true" class="contact-bar__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 3a9 9 0 00-7.7 13.7L3 21l4.4-1.3A9 9 0 1012 3z" />
              <path d="M8.5 9c0 4 2.5 6.5 6.5 6.5l1-1.8-2.3-1-1 1a5.6 5.6 0 01-2.4-2.4l1-1-1-2.3z" />
            </svg>
          </span>
          WhatsApp
        </a>
      )}
    </div>
  )
}

<style>
  .contact-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 45;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    background-color: var(--color-rich-black);
    color: var(--color-warm-cream);
    border-top: 1px solid color-mix(in srgb, var(--color-warm-cream) 18%, transparent);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .contact-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 3.75rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .contact-bar__item:hover {
    background-color: var(--color-charcoal);
  }

  .contact-bar__icon svg {
    width: 20px;
    height: 20px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 64rem) {
    .contact-bar {
      display: none;
    }
  }
</style>
