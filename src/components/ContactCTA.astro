---
import MediaSlot from './MediaSlot.astro';
import { site } from '../data/site';

/** Copy y estructura del boceto. Datos confirmados en la decision 13. */
---

<section class="cta surface-dark on-dark">
  <div class="cta__grid">
    <div class="shell cta__text">
      <h2 class="t-h2 cta__title">Ready to transform<br />your outdoor space?</h2>
      <p class="cta__body">
        Schedule a consultation and take the first step toward a space you&rsquo;ll love for
        years to come.
      </p>
      <a href="/contact" class="btn btn-primary">Start Your Project</a>
    </div>

    <div class="cta__media">
      <MediaSlot
        kind="image"
        ratio="4 / 3"
        label="Outdoor living at dusk: fire feature and seating"
      />
    </div>

    <ul class="cta__points">
      <li class="cta__point">
        <span class="cta__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="5" width="18" height="16" />
            <path d="M3 10h18M8 3v4M16 3v4" />
          </svg>
        </span>
        Schedule a Consultation
      </li>

      <li class="cta__point">
        <span class="cta__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 21s7-5.5 7-11a7 7 0 10-14 0c0 5.5 7 11 7 11z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
        </span>
        Serving {site.serviceArea}
      </li>

      {
        site.licensed && (
          <li class="cta__point">
            <span class="cta__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6z" />
              </svg>
            </span>
            Licensed &amp; Insured
          </li>
        )
      }
    </ul>
  </div>
</section>

<style>
  .cta__grid {
    display: grid;
    gap: 0;
    align-items: center;
  }

  .cta__text {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .cta__title {
    margin: 0 0 1.25rem;
  }

  .cta__body {
    margin: 0 0 2rem;
    max-width: 42ch;
    color: color-mix(in srgb, var(--color-warm-cream) 82%, transparent);
  }

  .cta__points {
    list-style: none;
    margin: 0;
    padding: clamp(2rem, 5vw, 3rem) var(--spacing-gutter);
    display: grid;
    gap: 1.75rem;
  }

  .cta__point {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.9375rem;
  }

  .cta__icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-sandstone);
  }

  .cta__icon svg {
    width: 22px;
    height: 22px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 62rem) {
    .cta__grid {
      grid-template-columns: 1.1fr 1fr 0.8fr;
    }

    .cta__media {
      align-self: stretch;
    }

    .cta__media :global(.media-slot) {
      height: 100%;
    }
  }
</style>
