---
import SectionLabel from './SectionLabel.astro';
import { segmentById } from '../data/segments';
import { serviceBySlug } from '../data/services';
import { site } from '../data/site';

/**
 * Entrada Commercial: seccion "A Reliable Partner" y formulario de bid
 * request (pedido del cliente 2026-10-16: empresa, contacto, ubicacion,
 * servicios, fecha de inicio, fecha limite del bid y planos). Lo abren este
 * boton y los dos del hero comercial (cualquier [data-commercial-open]).
 *
 * Solo se ve en el segmento Commercial (data-seg, ver global.css). El
 * formulario vive en un <dialog> nativo: showModal() da foco atrapado, Escape
 * y aria-modal sin codigo propio. Aqui SI es un modal de verdad, a diferencia
 * del selector de entrada, porque el usuario lo abre a proposito y no hay
 * gesto de scroll que respetar.
 *
 * Sin JS el boton no puede abrir el dialogo, asi que es un enlace real a
 * /contact y el script lo convierte en boton al cargar (mejora progresiva).
 *
 * El destino sigue PENDIENTE igual que en ConsultationForm: mientras
 * `site.formEndpoint` sea null el envio queda deshabilitado con aviso visible
 * y se ofrece el correo. Basta con poner la URL en site.ts.
 */
const enabled = site.formEndpoint !== null;

const commercial = segmentById('commercial');
const serviceOptions = (commercial?.homeServices ?? [])
  .map((slug) => serviceBySlug(slug))
  .filter((s) => s !== undefined);

const roles = [
  'General contractor',
  'Developer',
  'Property manager',
  'Property owner',
  'Architect or designer',
  'Other',
];

const propertyTypes = [
  'Retail plaza or shopping center',
  'HOA or condominium association',
  'Hotel or hospitality',
  'Office or business park',
  'Mixed-use or new development',
  'Other',
];

/**
 * "A Reliable Partner" (pedido del cliente 2026-10-16). Solo describe
 * servicios y como se cotiza: no se inventan proyectos ni experiencia
 * comercial previa.
 */
const partnerPoints = [
  {
    title: 'What we bid on',
    text: 'Paver installation, pool decks, stone veneer and architectural surfaces, commercial exterior improvements, and cleaning, sealing and restoration.',
  },
  {
    title: 'How we estimate',
    text: 'Send us your drawings or specifications. We review the scope, visit the site when needed, and return a clear, itemized proposal by your bid deadline.',
  },
  {
    title: 'Open to new opportunities',
    text: 'New construction, renovations and maintenance work. If you have a project out to bid, we are glad to review it.',
  },
];
---

<section class="section commercial-inquiry" id="commercial-contact" data-seg="commercial">
  <div class="shell">
    <SectionLabel label="Commercial Projects" />

    <div class="commercial-inquiry__grid">
      <div>
        <h2 class="t-h2">A Reliable Partner for Your Next Project</h2>
        <p class="measure commercial-inquiry__lead">
          We work alongside general contractors, developers, property managers and commercial
          property owners throughout Palm Beach County and South Florida.
        </p>
      </div>

      <a href="/contact" class="btn btn-solid" data-commercial-open aria-haspopup="dialog">
        Invite Us to Bid
      </a>
    </div>

    <ul class="commercial-inquiry__points">
      {
        partnerPoints.map((point) => (
          <li class="commercial-inquiry__point">
            <h3 class="t-label commercial-inquiry__point-title">{point.title}</h3>
            <p class="commercial-inquiry__point-text">{point.text}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="modal" id="commercial-dialog" aria-labelledby="commercial-dialog-title">
    <div class="modal__panel">
      <button type="button" class="modal__close" id="commercial-form-close">
        <span class="sr-only">Close</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>

      <h2 class="t-h2 modal__title" id="commercial-dialog-title">Commercial Bid Request</h2>
      <p class="modal__lead">
        Tell us about the project and attach drawings or specifications if you have them. We will review it and follow up.
      </p>

      <form
        class="form"
        id="commercial-form"
        method="post"
        enctype="multipart/form-data"
        action={site.formEndpoint ?? undefined}
        novalidate
      >
        <input type="hidden" name="segment" value="commercial" />
        <input type="hidden" name="_subject" value="New commercial bid request - StoneCraft ProWorks" />

        {
          !enabled && (
            <p class="form__notice" role="status">
              <strong>Online submission is not connected yet.</strong> Send your project
              details to <a href={`mailto:${site.email}`}>{site.email}</a> and we will get back
              to you.
            </p>
          )
        }

        <div class="form__errors" id="commercial-form-errors" role="alert" aria-live="assertive" hidden>
        </div>

        <div class="form__row">
          <div class="field">
            <label class="t-label field__label" for="c-company">Company name</label>
            <input class="field__input" type="text" id="c-company" name="company" required autocomplete="organization" />
          </div>

          <div class="field">
            <label class="t-label field__label" for="c-name">Contact name</label>
            <input class="field__input" type="text" id="c-name" name="name" required autocomplete="name" />
          </div>
        </div>

        <div class="form__row">
          <div class="field">
            <label class="t-label field__label" for="c-email">Email</label>
            <input class="field__input" type="email" id="c-email" name="email" required autocomplete="email" />
          </div>

          <div class="field">
            <label class="t-label field__label" for="c-phone">Phone</label>
            <input class="field__input" type="tel" id="c-phone" name="phone" required autocomplete="tel" />
          </div>
        </div>

        <div class="form__row">
          <div class="field">
            <label class="t-label field__label" for="c-role">Your role</label>
            <select class="field__input" id="c-role" name="role" required>
              <option value="">Select an option</option>
              {roles.map((role) => <option value={role}>{role}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="t-label field__label" for="c-property">
              Property type <span class="field__optional">(optional)</span>
            </label>
            <select class="field__input" id="c-property" name="propertyType">
              <option value="">Select an option</option>
              {propertyTypes.map((type) => <option value={type}>{type}</option>)}
            </select>
          </div>
        </div>

        <div class="field">
          <label class="t-label field__label" for="c-location">Project location</label>
          <input class="field__input" type="text" id="c-location" name="location" required placeholder="City or address" />
        </div>

        <fieldset class="field field__group">
          <legend class="t-label field__label">Services needed</legend>
          <div class="field__checks">
            {
              serviceOptions.map((service) => (
                <label class="field__check">
                  <input type="checkbox" name="services" value={service.name} />
                  <span>{service.name}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="form__row">
          <div class="field">
            <label class="t-label field__label" for="c-start">
              Estimated start date <span class="field__optional">(optional)</span>
            </label>
            <input class="field__input" type="date" id="c-start" name="startDate" />
          </div>

          <div class="field">
            <label class="t-label field__label" for="c-deadline">
              Bid deadline <span class="field__optional">(optional)</span>
            </label>
            <input class="field__input" type="date" id="c-deadline" name="bidDeadline" />
          </div>
        </div>

        <div class="field">
          <label class="t-label field__label" for="c-files">
            Drawings or specifications <span class="field__optional">(optional: PDF, DWG or images)</span>
          </label>
          <input class="field__input field__file" type="file" id="c-files" name="attachments" multiple
            accept=".pdf,.dwg,.dxf,.jpg,.jpeg,.png" />
        </div>

        <div class="field">
          <label class="t-label field__label" for="c-plans-link">
            Or a link to the plans <span class="field__optional">(optional: Dropbox, Google Drive...)</span>
          </label>
          <input class="field__input" type="url" id="c-plans-link" name="plansLink" placeholder="https://" />
        </div>

        <div class="field">
          <label class="t-label field__label" for="c-message">Project scope and details</label>
          <textarea class="field__input field__textarea" id="c-message" name="message" rows="4" required
          ></textarea>
        </div>

        <p class="form__status" data-form-status role="status" hidden></p>

        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="form__trap" aria-hidden="true" />

        <button type="submit" class="btn btn-solid form__submit" disabled={!enabled}>
          Submit Bid Request
        </button>
      </form>
    </div>
  </dialog>
</section>

<script>
  import { bindFormValidation } from '../scripts/form-validation';
  import { bindFormSubmit } from '../scripts/form-submit';

  const openers = document.querySelectorAll<HTMLElement>('[data-commercial-open]');
  const dialog = document.getElementById('commercial-dialog');
  const closer = document.getElementById('commercial-form-close');
  const form = document.getElementById('commercial-form');
  const errorBox = document.getElementById('commercial-form-errors');

  if (dialog instanceof HTMLDialogElement) {
    // Con JS cada enlace pasa a ser un boton que abre el dialogo (los del
    // hero comercial y el de esta seccion). Se recuerda cual lo abrio.
    let lastOpener: HTMLElement | null = null;
    openers.forEach((opener) => {
      opener.setAttribute('role', 'button');
      opener.addEventListener('click', (event) => {
        event.preventDefault();
        lastOpener = opener;
        dialog.showModal();
      });
    });

    closer?.addEventListener('click', () => dialog.close());

    // Clic en el fondo oscuro (el propio <dialog>, fuera del panel) cierra.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Al cerrar, el foco vuelve al boton que lo abrio.
    dialog.addEventListener('close', () => lastOpener?.focus());
  }

  if (form instanceof HTMLFormElement && errorBox) {
    bindFormValidation(form, errorBox);
    bindFormSubmit(form, 'Thank you. We received your bid request and will review it and follow up shortly.');
  }
</script>

<style>
  .commercial-inquiry__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .commercial-inquiry__points {
    display: grid;
    gap: 2rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .commercial-inquiry__point {
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-charcoal) 25%, transparent);
  }

  .commercial-inquiry__point-title {
    margin: 0 0 0.75rem;
    color: var(--color-rich-black);
  }

  .commercial-inquiry__point-text {
    margin: 0;
    color: var(--color-charcoal);
  }

  .field__group {
    margin: 0;
    padding: 0;
    border: none;
  }

  .field__checks {
    display: grid;
    gap: 0.75rem;
  }

  .field__check {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .field__check input {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.15rem;
    accent-color: var(--color-rich-black);
  }

  .field__file {
    padding-block: 0.6rem;
  }

  .commercial-inquiry__lead {
    margin: 1.25rem 0 0;
    color: var(--color-charcoal);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .modal {
    width: min(44rem, calc(100% - 2.5rem));
    max-height: calc(100dvh - 2.5rem);
    margin: auto; /* el reset de Tailwind lo pone a 0 y el dialogo se va a la esquina */
    padding: 0;
    border: none;
    background-color: var(--color-warm-cream);
    color: var(--color-rich-black);
    overflow-y: auto;
  }

  .modal::backdrop {
    background-color: color-mix(in srgb, var(--color-rich-black) 78%, transparent);
  }

  /* Sin esto la pagina de detras sigue haciendo scroll con el modal abierto. */
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }

  .modal__panel {
    position: relative;
    padding: clamp(1.75rem, 5vw, 3rem);
  }

  .modal__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: none;
    color: var(--color-charcoal);
    cursor: pointer;
    transition: color 200ms ease;
  }

  .modal__close:hover {
    color: var(--color-rich-black);
  }

  .modal__close svg {
    width: 20px;
    height: 20px;
    stroke-linecap: round;
  }

  .modal__title {
    margin: 0 2.5rem 0.75rem 0;
  }

  .modal__lead {
    margin: 0 0 2rem;
    color: var(--color-charcoal);
  }

  .form {
    display: grid;
    gap: 1.5rem;
  }

  .form__row {
    display: grid;
    gap: 1.5rem;
  }

  .form__notice {
    margin: 0;
    padding: 1rem 1.25rem;
    background-color: color-mix(in srgb, var(--color-sandstone) 30%, var(--color-warm-cream));
    border-left: 3px solid var(--color-warm-taupe);
    font-size: 0.9375rem;
  }

  .form__notice a,
  .form__errors a {
    border-bottom: 1px solid currentColor;
  }

  .form__status {
    margin: 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-warm-taupe);
    background-color: color-mix(in srgb, var(--color-sandstone) 30%, var(--color-warm-cream));
    font-size: 0.9375rem;
  }

  .form__status[data-kind='error'] {
    border-left-color: #9b2c2c;
    background-color: color-mix(in srgb, #9b2c2c 8%, var(--color-warm-cream));
  }

  /* Honeypot anti-spam: fuera de pantalla, no display:none (los bots lo detectan). */
  .form__trap {
    position: absolute;
    left: -9999px;
  }

  .form__errors {
    padding: 1rem 1.25rem;
    border-left: 3px solid #9b2c2c;
    background-color: color-mix(in srgb, #9b2c2c 8%, var(--color-warm-cream));
    font-size: 0.9375rem;
  }

  .form__errors :global(p) {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  .form__errors :global(ul) {
    margin: 0;
    padding-left: 1.25rem;
  }

  .field {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .field__label {
    color: var(--color-charcoal);
  }

  .field__optional {
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.7;
  }

  .field__input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-rich-black);
    background-color: #fff;
    border: 1px solid color-mix(in srgb, var(--color-charcoal) 35%, transparent);
    transition: border-color 200ms ease;
  }

  .field__input:hover {
    border-color: color-mix(in srgb, var(--color-charcoal) 60%, transparent);
  }

  .field__input[aria-invalid='true'] {
    border-color: #9b2c2c;
    border-width: 2px;
  }

  .field__textarea {
    min-height: 7rem;
    resize: vertical;
  }

  .form__submit {
    justify-self: start;
  }

  @media (min-width: 40rem) {
    .field__checks {
      grid-template-columns: 1fr 1fr;
    }

    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 48rem) {
    .commercial-inquiry__grid {
      grid-template-columns: 1fr auto;
      gap: 4rem;
    }

    .commercial-inquiry__points {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
</style>
