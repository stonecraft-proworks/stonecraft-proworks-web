---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileContactBar from '../components/MobileContactBar.astro';
import AudienceSelector from '../components/AudienceSelector.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** El selector de audiencia solo se ofrece en la portada. */
  showSelector?: boolean;
}

const { title, description, showSelector = false } = Astro.props;
const fullTitle = `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const shareImage = new URL('/icon-512.png', Astro.site ?? site.url).href;

/**
 * LocalBusiness (decision 2 dependiente): solo se incluyen los campos que
 * ya existen. Telefono y direccion siguen PENDIENTES en site.ts, asi que
 * no se inventan aqui tampoco: Google trata un telefono o direccion falsos
 * peor que no tenerlos.
 */
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: site.url,
  email: site.email,
  areaServed: site.serviceArea,
  ...(site.phone ? { telephone: site.phone } : {}),
  ...(site.address ? { address: site.address } : {}),
};
---

<!doctype html>
<html lang="en" data-segment="residential">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-transparent.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

    {/*
      Se aplica el segmento guardado ANTES del primer paint para que no
      haya parpadeo entre el contenido residencial y el comercial.
      Sin JS la pagina se queda en 'residential', que es el estado por
      defecto acordado cuando no hay eleccion.
    */}
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('sc-segment');
          if (s === 'residential' || s === 'commercial') {
            document.documentElement.dataset.segment = s;
            document.documentElement.dataset.segmentChosen = 'true';
          }
          if (sessionStorage.getItem('sc-selector-dismissed') === 'true') {
            document.documentElement.dataset.selectorDismissed = 'true';
          }
        } catch (e) {
          /* Modo privado o storage bloqueado: se sigue con el defecto. */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileContactBar />
    {showSelector && <AudienceSelector />}
  </body>
</html>
