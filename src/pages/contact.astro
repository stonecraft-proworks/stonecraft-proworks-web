---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import { site } from '../data/site';
---

<Base
  title="Request a Consultation"
  description="Schedule a consultation with StoneCraft ProWorks and take the first step toward your outdoor space."
>
  <PageHeader
    eyebrow="Get in touch"
    title="Request a Consultation"
    lead="Tell us about your space and goals. We will get back to you with the next step."
  />

  <section class="section">
    <div class="shell contact__grid">
      <ConsultationForm />

      <aside class="contact__aside">
        <h2 class="t-label contact__heading">Direct contact</h2>
        <ul class="contact__list">
          <li>
            <a href={`mailto:${site.email}`} class="contact__link">{site.email}</a>
          </li>
          {site.phone && (
            <li>
              <a href={`tel:${site.phone}`} class="contact__link">{site.phone}</a>
            </li>
          )}
          <li class="contact__meta">Serving {site.serviceArea}</li>
          {site.licensed && <li class="contact__meta">Licensed &amp; Insured</li>}
        </ul>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .contact__heading {
    margin: 0 0 1.25rem;
    color: var(--color-charcoal);
  }

  .contact__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .contact__link {
    border-bottom: 1px solid currentColor;
  }

  .contact__meta {
    color: var(--color-charcoal);
  }

  @media (min-width: 62rem) {
    .contact__grid {
      grid-template-columns: 1.6fr 1fr;
    }
  }
</style>
