---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<Base
  title="Outdoor Living Inspiration"
  description="Outdoor living ideas for South Florida homes and commercial properties: pool decks, pavers, outdoor kitchens and more."
>
  <PageHeader
    eyebrow="Gallery"
    title="Outdoor Living Inspiration"
    lead="Ideas for your next outdoor space. Images marked “AI visualization” are design concepts, not completed StoneCraft projects."
  />
  <ProjectsGrid showLink={false} count={9} />
  <BeforeAfter />
  <ContactCTA />
</Base>
